---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { projects, type Project } from '../../data/projects';
import { url } from '../../lib/urls';
export function getStaticPaths() {
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}
interface Props {
  project: Project;
}
const { project } = Astro.props;
const sections = [
  ['Problem', project.problem],
  ['Constraints', project.constraints],
  ['Approach', project.approach],
  ['Results', project.impact],
];
---

<Base title={project.title} description={project.description}>
  <header class="page-heading">
    <p class="eyebrow">
      {project.category} / {project.context}
    </p>
    <h1>{project.title}</h1>
    <p class="lead">{project.description}</p>
    <div class="tag-list">
      {project.tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
    {project.github && (
      <a class="text-link primary" href={project.github}>
        Repository <Icon name="external" size={15} />
      </a>
    )}
    {project.reference && (
      <a class="text-link" href={project.reference}>
        Project information on LinkedIn <Icon name="external" size={15} />
      </a>
    )}
  </header>
  <article class="project-detail">
    {sections.map(([heading, body]) => (
      <section class="detail-section">
        <h2>{heading}</h2>
        <p>{body}</p>
      </section>
    ))}
    {project.note && <aside class="callout">{project.note}</aside>}
    <a class="text-link back-link" href={url('projects/')}>
      <span aria-hidden="true">←</span> Back to projects
    </a>
  </article>
</Base>
