---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Portrait from '../components/Portrait.astro';
import { site } from '../data/site';
import { thesis } from '../data/research';
import { projects } from '../data/projects';
import { getPosts } from '../lib/posts';
import { url } from '../lib/urls';
const posts = (await getPosts()).slice(0, 2);
---

<Base>
  <section class="introduction" aria-labelledby="intro">
    <div class="introduction-copy">
      <h1 id="intro">{site.name}</h1>
      <p class="role">{site.role}</p>
      <p class="bio">{site.bio}</p>
      <p class="current-position">
        I currently work as an AI Solutions Engineer at {site.currentOrganization}.
      </p>
      <p class="introduction-links">
        <a href={url('about/')}>About</a>
        <a href={site.github}>GitHub</a>
        <a href={site.linkedin}>LinkedIn</a>
        <a href={url('cv/')}>Curriculum vitae</a>
      </p>
    </div>
    <Portrait />
  </section>

  <section class="section" aria-labelledby="research-heading">
    <div class="section-heading">
      <div class="section-title">
        <h2 id="research-heading">Research</h2>
      </div>
      <a class="text-link" href={url('research/')}>
        Research overview
      </a>
    </div>
    <article class="research-feature">
      <div>
        <p class="entry-meta">Undergraduate thesis · Neuro-symbolic AI</p>
        <h3>
          <a href={url('research/#thesis')}>{thesis.title}</a>
        </h3>
        <p>{thesis.description}</p>
      </div>
    </article>
  </section>

  <section class="section" aria-labelledby="projects-heading">
    <div class="section-heading">
      <div class="section-title">
        <h2 id="projects-heading">Selected projects</h2>
      </div>
      <a class="text-link" href={url('projects/')}>
        All projects
      </a>
    </div>
    <div class="project-grid">
      {projects
        .filter((p) => p.featured)
        .map((project) => (
          <article class="project-card">
            <span class="project-category">{project.category}</span>
            <h3>
              <a href={url(`projects/${project.id}/`)}>{project.title}</a>
            </h3>
            <p>{project.description}</p>
            <div class="tag-list">
              {project.tags.slice(0, 3).map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </article>
        ))}
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section" aria-labelledby="writing-heading">
      <div class="section-heading">
        <div class="section-title">
          <h2 id="writing-heading">Recent articles</h2>
        </div>
        <a class="text-link" href={url('writing/')}>
          All articles
        </a>
      </div>
      <PostList posts={posts} />
    </section>
  )}
</Base>
